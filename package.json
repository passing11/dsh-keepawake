{
  "name": "dsh-keepawake",
  "version": "1.0.0",
  "description": "DSH 保活开关：在会话右侧放一个开关，开启期间 DSH 思考、调工具、跟模型对话时电脑不会睡眠/休眠（Windows）。",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "scripts/dsh-keepawake-watch.ps1",
    "scripts/keepawake-toggle.ps1",
    "scripts/keepawake-status.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "keep-awake",
    "windows",
    "power-management",
    "modern-standby"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/passing11/dsh-keepawake.git"
  },
  "homepage": "https://github.com/passing11/dsh-keepawake#readme",
  "bugs": {
    "url": "https://github.com/passing11/dsh-keepawake/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}